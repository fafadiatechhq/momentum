# ---------------------------------------------------------------
# Momentum — Docker environment configuration
# Copy this file to .env and fill in your values before running
# docker compose up.
# ---------------------------------------------------------------

# The site name used inside the bench.
# Must be domain-like (e.g. momentum.localhost for local use).
SITE_NAME=momentum.localhost

# MariaDB root password (used to create the site database)
DB_ROOT_PASSWORD=change_me_root

# ERPNext administrator password for the site
ADMIN_PASSWORD=change_me_admin

# Number of Gunicorn worker processes.
# Rule of thumb: (2 × CPU cores) + 1
GUNICORN_WORKERS=2

# Gunicorn request timeout in seconds.
# Increase if long-running reports time out.
GUNICORN_TIMEOUT=120

# Maximum upload size passed to nginx (e.g. 50m, 100m)
CLIENT_MAX_BODY_SIZE=50m
